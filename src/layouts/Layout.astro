---
// Supports weights 100-800
import { Font } from "astro:assets";
import "~/styles/global.css";
import { SEO } from 'astro-seo';
import Footer from '@components/Footer.astro';
import TopBar from '@components/TopBar.astro';

export interface Props {
  port?: string;
  home?: boolean;
  solid?: boolean;
  meta: {
    title: string;
    description: string;
    image: string;
  };
}

const { port, home, meta, solid } = Astro.props as Props;
---

<!doctype html>
<html lang="en" id="top" class="bg-dark-purple list-decimal scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={meta.title}
      description={meta.description}
      openGraph={{
        basic: {
          title: meta.title,
          type: 'website',
          image: meta.image,
        },
      }}
      extend={{
          link: [
            { rel: "icon", type:"image/png", href: "/favicon/favicon-96x96.png", sizes: "96x96"},
            { rel: "icon", type:"image/svg+xml", href: "/favicon/favicon.svg"},
            { rel: "shortcut icon", href: "/favicon/favicon.ico"},
            { rel: "apple-touch-icon", href: "/favicon/apple-touch-icon.png", sizes: "180x180"},
            { rel: "manifest", href: "/favicon/site.webmanifest"},
          ],
          meta: [
            { name: "apple-mobile-web-app-title", content: "Wildberries" }
          ]
      }}
    />
    <Font cssVariable="--font-jetbrains-mono" />
    {Astro.url.hostname !== "localhost" &&
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="5e45fe7d-9267-49ac-ab38-a58fd8903bd3"></script>
    }
  </head>
  <TopBar search={home} solid={solid} port={port} />
  <body id="top">
    <slot />
  </body>
  <Footer />
</html>
